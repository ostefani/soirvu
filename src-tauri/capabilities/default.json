{
    "$schema": "../gen/schemas/desktop-schema.json",
    "description": "The main window gets Tauri core defaults plus the app's own commands (the allow-* permissions generated from the AppManifest in build.rs). No plugin permissions: no fs, no shell, no http, no opener, no dialog.",
    "identifier": "default",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "allow-vault-list",
        "allow-vault-pick-folder",
        "allow-vault-create",
        "allow-vault-unlock",
        "allow-vault-unlock-touch-id",
        "allow-touch-id-status",
        "allow-touch-id-enroll",
        "allow-touch-id-disable",
        "allow-vault-lock",
        "allow-vault-forget",
        "allow-vault-relocate",
    "allow-vault-fork-import",
    "allow-vault-change-passphrase",
    "allow-vault-regenerate-recovery",
    "allow-vault-rotate-master-key",
        "allow-entry-list",
        "allow-entry-get",
        "allow-entry-save",
        "allow-entry-delete",
        "allow-calendar-days",
        "allow-on-this-day",
        "allow-search",
        "allow-tag-list",
        "allow-tag-rename",
        "allow-tag-merge",
    "allow-tag-delete",
        "allow-open-link",
    "allow-clipboard-note-copy",
    "allow-backup-now",
    "allow-export-markdown",
    "allow-export-json",
    "allow-import-markdown",
    "allow-import-json",
        "allow-settings-get",
        "allow-settings-set",
        "allow-settings-pick-backup-dir",
        "allow-settings-clear-backup-dir",
        "allow-attachment-begin",
        "allow-attachment-chunk",
        "allow-attachment-finish",
        "allow-attachment-abort",
        "allow-attachment-info",
        "allow-attachment-import",
        "allow-attachment-open"
    ]
}
