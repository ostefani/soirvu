diff --git a/crates/soirvu-cli/src/main.rs b/crates/soirvu-cli/src/main.rs
new file mode 100644
index 0000000..37a896d
--- /dev/null
+++ b/crates/soirvu-cli/src/main.rs
@@ -0,0 +1,216 @@
+//! soirvu-cli — the recovery escape hatch (DESIGN §2, §8).
+//!
+//! It runs the same `soirvu-core` code as the app, so a vault can be
+//! created, checked and exported even if the GUI is broken or gone.
+//! No argument-parsing crate: the surface is four commands, parsed by hand.
+//!
+//! Commands:
+//!   soirvu-cli create <vault-dir>
+//!   soirvu-cli header-info <vault-dir>
+//!   soirvu-cli verify <vault-dir> [--recovery <key>]
+//!   soirvu-cli export <vault-dir> <out-dir> [--recovery <key>]
+//!
+//! The passphrase comes from the SOIRVU_PASSPHRASE environment variable,
+//! or is asked for at the terminal (with echo off). `--recovery` takes the
+//! recovery key text instead of a passphrase.
+//!
+//! Exit codes: 0 = ok, 1 = the command failed or verify found problems,
+//! 2 = the command line itself was wrong.
+
+use std::env;
+use std::io::{self, BufRead, IsTerminal, Write};
+use std::path::Path;
+use std::process::ExitCode;
+use std::time::Duration;
+
+use soirvu_core::crypto::{KdfParams, RecoveryKey};
+use soirvu_core::vault::VaultHeader;
+use soirvu_core::{Error, Vault};
+
+const HEADER_FILE: &str = "vault.header.json";
+
+fn main() -> ExitCode {
+    let args: Vec<String> = env::args().skip(1).collect();
+    match run(&args) {
+        Ok(()) => ExitCode::from(0),
+        Err(RunError::Usage) => {
+            eprint!("{USAGE}");
+            ExitCode::from(2)
+        }
+        Err(RunError::Failed(message)) => {
+            eprintln!("error: {message}");
+            ExitCode::from(1)
+        }
+    }
+}
+
+enum RunError {
+    Usage,
+    Failed(String),
+}
+
+fn failed(error: Error) -> RunError {
+    RunError::Failed(error.to_string())
+}
+
+const USAGE: &str = "\
+soirvu-cli — create, check and export a Soirvu vault without the app
+
+  soirvu-cli create <vault-dir>
+  soirvu-cli header-info <vault-dir>
+  soirvu-cli verify <vault-dir> [--recovery <key>]
+  soirvu-cli export <vault-dir> <out-dir> [--recovery <key>]
+
+The passphrase is read from SOIRVU_PASSPHRASE, or asked for at the
+terminal with echo off. Export writes PLAINTEXT — see DESIGN §8.
+";
+
+fn run(args: &[String]) -> Result<(), RunError> {
+    let (cmd, rest) = args.split_first().ok_or(RunError::Usage)?;
+    match cmd.as_str() {
+        "create" if rest.len() == 1 => create(Path::new(&rest[0])),
+        "header-info" if rest.len() == 1 => header_info(Path::new(&rest[0])),
+        "verify" if !rest.is_empty() => {
+            let (dirs, recovery) = open_args(rest)?;
+            if dirs.len() != 1 {
+                return Err(RunError::Usage);
+            }
+            verify(Path::new(&dirs[0]), recovery)
+        }
+        "export" if rest.len() >= 2 => {
+            let (dirs, recovery) = open_args(rest)?;
+            if dirs.len() != 2 {
+                return Err(RunError::Usage);
+            }
+            export(Path::new(&dirs[0]), Path::new(&dirs[1]), recovery)
+        }
+        _ => Err(RunError::Usage),
+    }
+}
+
+/// Splits `[paths..., --recovery <key>]` into the paths and the key text.
+fn open_args(args: &[String]) -> Result<(&[String], Option<&str>), RunError> {
+    if args.len() >= 2 && args[args.len() - 2] == "--recovery" {
+        Ok((&args[..args.len() - 2], Some(args[args.len() - 1].as_str())))
+    } else if args.iter().any(|a| a == "--recovery") {
+        Err(RunError::Usage)
+    } else {
+        Ok((args, None))
+    }
+}
+
+fn create(dir: &Path) -> Result<(), RunError> {
+    let passphrase = read_passphrase("New passphrase: ")?;
+    if passphrase.is_empty() {
+        return Err(RunError::Failed(Error::EmptyPassphrase.to_string()));
+    }
+    // Calibrated on this machine, about 0.5–1 s per unlock (DESIGN §5).
+    let kdf = KdfParams::calibrate(Duration::from_millis(750)).map_err(failed)?;
+    let (vault, recovery) = Vault::create(dir, &passphrase, kdf).map_err(failed)?;
+    let vault_id = vault.header().vault_id.clone();
+    vault.lock();
+    println!("Vault created: {vault_id}");
+    println!("Recovery key — write it down now, it is shown only once:");
+    println!("{}", recovery.to_text());
+    Ok(())
+}
+
+fn header_info(dir: &Path) -> Result<(), RunError> {
+    let bytes = std::fs::read(dir.join(HEADER_FILE))
+        .map_err(|e| RunError::Failed(format!("cannot read the vault header: {e}")))?;
+    let header = VaultHeader::from_json(&bytes).map_err(failed)?;
+    println!("format version: {}", header.format_version);
+    println!("suite: {}", header.suite);
+    println!("vault id: {}", header.vault_id);
+    for slot in &header.slots {
+        match slot {
+            soirvu_core::vault::Slot::Passphrase { kdf, .. } => {
+                println!(
+                    "slot: passphrase (Argon2id, m = {} KiB, t = {}, p = {})",
+                    kdf.m_kib, kdf.t, kdf.p
+                );
+            }
+            soirvu_core::vault::Slot::Recovery { .. } => println!("slot: recovery key"),
+        }
+    }
+    Ok(())
+}
+
+fn open(dir: &Path, recovery: Option<&str>) -> Result<Vault, RunError> {
+    match recovery {
+        Some(text) => {
+            let key = RecoveryKey::from_text(text).map_err(failed)?;
+            Vault::open_with_recovery(dir, &key).map_err(failed)
+        }
+        None => {
+            let passphrase = read_passphrase("Passphrase: ")?;
+            Vault::open_with_passphrase(dir, &passphrase).map_err(failed)
+        }
+    }
+}
+
+fn verify(dir: &Path, recovery: Option<&str>) -> Result<(), RunError> {
+    let vault = open(dir, recovery)?;
+    let report = vault.verify().map_err(failed)?;
+    println!(
+        "entries: {} ({} deleted), attachments: {} ({} bytes)",
+        report.entries, report.tombstones, report.attachments, report.attachment_bytes
+    );
+    if report.ok() {
+        println!("verify: OK");
+        Ok(())
+    } else {
+        for problem in &report.problems {
+            println!("problem: {problem}");
+        }
+        Err(RunError::Failed(format!(
+            "verify found {} problem(s)",
+            report.problems.len()
+        )))
+    }
+}
+
+fn export(dir: &Path, out: &Path, recovery: Option<&str>) -> Result<(), RunError> {
+    eprintln!("warning: export writes your diary as PLAINTEXT files.");
+    let vault = open(dir, recovery)?;
+    let report = vault.export_markdown(out).map_err(failed)?;
+    println!(
+        "exported {} entries and {} attachments to {}",
+        report.entries,
+        report.attachments,
+        report.dir.display()
+    );
+    Ok(())
+}
+
+/// Passphrase from SOIRVU_PASSPHRASE, else a terminal prompt with echo off
+/// (via `stty`; if that fails the typed text is visible), else a line from
+/// standard input (for scripts that pipe it).
+fn read_passphrase(prompt: &str) -> Result<String, RunError> {
+    if let Ok(passphrase) = env::var("SOIRVU_PASSPHRASE") {
+        return Ok(passphrase);
+    }
+    let stdin = io::stdin();
+    let mut line = String::new();
+    if stdin.is_terminal() {
+        eprint!("{prompt}");
+        let _ = io::stderr().flush();
+        let echo_off = std::process::Command::new("stty")
+            .arg("-echo")
+            .status()
+            .map(|s| s.success())
+            .unwrap_or(false);
+        let read = stdin.lock().read_line(&mut line);
+        if echo_off {
+            let _ = std::process::Command::new("stty").arg("echo").status();
+            eprintln!();
+        }
+        read.map_err(|e| RunError::Failed(e.to_string()))?;
+    } else {
+        stdin
+            .lock()
+            .read_line(&mut line)
+            .map_err(|e| RunError::Failed(e.to_string()))?;
+    }
+    Ok(line.trim_end_matches(['\n', '\r']).to_string())
+}
diff --git a/crates/soirvu-cli/tests/cli.rs b/crates/soirvu-cli/tests/cli.rs
new file mode 100644
index 0000000..93a7a1a
--- /dev/null
+++ b/crates/soirvu-cli/tests/cli.rs
@@ -0,0 +1,158 @@
+//! End-to-end tests: run the real `soirvu-cli` binary against real vaults.
+//! Vaults with content are made through `soirvu-core` directly — the CLI
+//! has no "add entry" command on purpose; it is a recovery tool.
+
+use std::fs;
+use std::process::{Command, Output};
+
+use soirvu_core::crypto::KdfParams;
+use soirvu_core::entries::EntryDraft;
+use soirvu_core::Vault;
+use tempfile::TempDir;
+
+const PASSPHRASE: &str = "correct horse battery staple";
+
+/// The weakest settings a REAL build accepts. The core's own unit tests
+/// use much weaker ones, but those only pass inside the core: its low
+/// floors are `#[cfg(test)]`, and a test of this crate compiles the core
+/// as a normal dependency, with the production floors (DESIGN §5).
+/// So vaults made here cost a real Argon2id run each. Still fast enough.
+fn fast() -> KdfParams {
+    KdfParams {
+        m_kib: 64 * 1024,
+        t: 3,
+        p: 1,
+    }
+}
+
+fn cli(args: &[&str], passphrase: &str) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_soirvu-cli"))
+        .args(args)
+        .env("SOIRVU_PASSPHRASE", passphrase)
+        .output()
+        .expect("run soirvu-cli")
+}
+
+fn stdout(output: &Output) -> String {
+    String::from_utf8_lossy(&output.stdout).into_owned()
+}
+
+/// A vault with one entry and one attachment, made with the core.
+/// Returns the temp dir, the vault dir, and the recovery key text.
+fn vault_with_content() -> (TempDir, std::path::PathBuf, String) {
+    let tmp = TempDir::new().unwrap();
+    let dir = tmp.path().join("v");
+    let (mut vault, recovery) = Vault::create(&dir, PASSPHRASE, fast()).unwrap();
+    let entry = vault
+        .create_entry(&EntryDraft {
+            entry_date: "2026-10-13".into(),
+            title: Some("Проверка".into()),
+            body_md: "текст про книгу".into(),
+            ..Default::default()
+        })
+        .unwrap();
+    vault
+        .add_attachment(&entry.id, "a.bin", "application/octet-stream", b"bytes")
+        .unwrap();
+    vault.lock();
+    (tmp, dir, recovery.to_text())
+}
+
+#[test]
+fn create_then_header_info_then_verify() {
+    let tmp = TempDir::new().unwrap();
+    let dir = tmp.path().join("v");
+    let dir_s = dir.to_string_lossy().into_owned();
+
+    // Note: `create` calibrates Argon2id on this machine, so it is slower
+    // than the other commands. That is the design (§5), not a bug.
+    let created = cli(&["create", &dir_s], PASSPHRASE);
+    assert!(created.status.success(), "{}", stdout(&created));
+    let text = stdout(&created);
+    assert!(text.contains("Vault created:"));
+    assert!(text.contains("Recovery key")); // shown once, at creation
+
+    let info = cli(&["header-info", &dir_s], PASSPHRASE);
+    assert!(info.status.success());
+    let text = stdout(&info);
+    assert!(text.contains("format version: 1"));
+    assert!(text.contains("slot: passphrase"));
+    assert!(text.contains("slot: recovery key"));
+
+    let checked = cli(&["verify", &dir_s], PASSPHRASE);
+    assert!(checked.status.success(), "{}", stdout(&checked));
+    assert!(stdout(&checked).contains("verify: OK"));
+}
+
+#[test]
+fn verify_and_export_work_with_the_recovery_key() {
+    let (_tmp, dir, recovery_text) = vault_with_content();
+    let dir_s = dir.to_string_lossy().into_owned();
+
+    // A wrong passphrase in the environment must not matter: --recovery
+    // replaces the passphrase entirely.
+    let checked = cli(&["verify", &dir_s, "--recovery", &recovery_text], "wrong");
+    assert!(checked.status.success(), "{}", stdout(&checked));
+    assert!(stdout(&checked).contains("entries: 1"));
+    assert!(stdout(&checked).contains("attachments: 1"));
+
+    let out = _tmp.path().join("out");
+    let out_s = out.to_string_lossy().into_owned();
+    let exported = cli(
+        &["export", &dir_s, &out_s, "--recovery", &recovery_text],
+        "wrong",
+    );
+    assert!(exported.status.success(), "{}", stdout(&exported));
+    assert!(stdout(&exported).contains("exported 1 entries and 1 attachments"));
+
+    let year = out.join("2026");
+    let files: Vec<_> = fs::read_dir(&year).unwrap().collect();
+    assert_eq!(files.len(), 1);
+    let md = fs::read_to_string(files[0].as_ref().unwrap().path()).unwrap();
+    assert!(md.contains("текст про книгу"));
+    assert!(md.contains("title: \"Проверка\""));
+}
+
+#[test]
+fn a_wrong_passphrase_fails() {
+    let (_tmp, dir, _recovery) = vault_with_content();
+    let dir_s = dir.to_string_lossy().into_owned();
+    let checked = cli(&["verify", &dir_s], "not the passphrase");
+    assert_eq!(checked.status.code(), Some(1));
+}
+
+#[test]
+fn create_refuses_a_folder_that_is_not_empty() {
+    let tmp = TempDir::new().unwrap();
+    fs::write(tmp.path().join("mine.txt"), b"precious").unwrap();
+    let dir_s = tmp.path().to_string_lossy().into_owned();
+    let created = cli(&["create", &dir_s], PASSPHRASE);
+    assert_eq!(created.status.code(), Some(1));
+    assert_eq!(fs::read(tmp.path().join("mine.txt")).unwrap(), b"precious");
+}
+
+#[test]
+fn no_arguments_is_a_usage_error() {
+    let out = cli(&[], PASSPHRASE);
+    assert_eq!(out.status.code(), Some(2));
+    let err = String::from_utf8_lossy(&out.stderr).into_owned();
+    assert!(err.contains("soirvu-cli create"), "{err}");
+}
+
+#[test]
+fn verify_reports_a_damaged_vault() {
+    let (_tmp, dir, _recovery) = vault_with_content();
+    // Damage the blob: flip its last byte.
+    let attachments = dir.join("attachments");
+    let shard = fs::read_dir(&attachments).unwrap().next().unwrap().unwrap().path();
+    let blob = fs::read_dir(&shard).unwrap().next().unwrap().unwrap().path();
+    let mut bytes = fs::read(&blob).unwrap();
+    let last = bytes.len() - 1;
+    bytes[last] ^= 0x01;
+    fs::write(&blob, bytes).unwrap();
+
+    let dir_s = dir.to_string_lossy().into_owned();
+    let checked = cli(&["verify", &dir_s], PASSPHRASE);
+    assert_eq!(checked.status.code(), Some(1));
+    assert!(stdout(&checked).contains("problem:"), "{}", stdout(&checked));
+}
